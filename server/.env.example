PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://konzotech:konzotech123@localhost:5432/konzotech_saas
JWT_SECRET=change-this-super-secret-key
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
APP_TIMEZONE=America/Toronto
SUPER_ADMIN_EMAILS=
PLAN_PRICE_PRO_MONTHLY=49
PLAN_PRICE_PREMIUM_MONTHLY=99

# Optional SMTP configuration (fallback is JSON transport)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Konzotech Agency <no-reply@konzotech.agency>

# Automated reminders
REMINDERS_ENABLED=true
REMINDERS_CRON=0 */6 * * *

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_SUCCESS_URL=http://localhost:5173/invoices?payment=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/invoices?payment=cancelled
BILLING_SUCCESS_URL=http://localhost:5173/settings?billing=success&session_id={CHECKOUT_SESSION_ID}
BILLING_CANCEL_URL=http://localhost:5173/settings?billing=cancelled

# WhatsApp Business Cloud API (optional, can also be saved from the app)
WHATSAPP_GRAPH_VERSION=v23.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
